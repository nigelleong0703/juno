{
  "name": "@juno/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Juno: chat turns as async iterators, approval callbacks, resumable conversations and background task events.",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "juno": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cli.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@agent-desktop/client": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^3.2.0"
  }
}
