{
  "manifest_version": 3,
  "name": "Juno Chrome Bridge",
  "version": "0.1.0",
  "description": "Explicit, per-tab Chrome control for Juno desktop.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Juno browser access",
    "default_popup": "popup.html"
  }
}
