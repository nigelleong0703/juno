# Local example only. Never commit credentials. Copy to .env for local dev.
# Three-service backend: api (public) + agentd (private control/execution) + computerd.
# Prerequisite: run `pnpm dev:infra` separately for Postgres, then migrate as needed.
# `pnpm dev:backend` (scripts/dev/backend.mjs) never seeds, resets, wipes data,
# provisions accounts, or starts duplicate infra on live ports.
#
# Postgres. The default dev database is the persistent Docker Postgres 18
# container started by `pnpm dev:infra` (mode "docker") on 127.0.0.1:54330 with
# the named volume vomu-postgres18-local-use. These credentials come from this
# gitignored file; the launcher derives DATABASE_URL from POSTGRES_* so keep the
# values in sync.
POSTGRES_PORT=54330
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/agents
# Postgres backend for `pnpm dev:infra`: "docker" (default) or "embedded".
# "embedded" is isolated test mode only (old embedded Postgres on 54329 under
# INFRA_DATA_DIR). Caution: the legacy embedded cluster is kept as a backup;
# nothing here migrates, seeds, resets or removes data. Only set DATABASE_URL to
# 54329 when you deliberately want that legacy cluster.
# INFRA_POSTGRES_MODE=embedded
# Infra state dir for `pnpm dev:infra` (embedded PG data).
# Fresh runs use a throwaway dir (e.g. .data/local-use); leave unset for ./.data.
# INFRA_DATA_DIR=.data/local-use
#
# Public API entry (packages/api). Frontend dev proxy targets this port; keep 8787.
API_PORT=8787
# Interface the api listens on (default 127.0.0.1: this machine only, which also covers `tailscale serve` and a reverse proxy on the
# same machine). A server that clients reach directly sets it explicitly: 0.0.0.0, or the private-network IP (see deploy/README.md).
# To reach a dev stack from a phone on the same Wi-Fi without a proxy, set 0.0.0.0 yourself.
# API_HOST=127.0.0.1
BETTER_AUTH_URL=http://127.0.0.1:8787
AUTH_MODE=account
# At least 32 random characters; placeholder only, never a real secret.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Comma-separated extra origins; default covers the desktop shell.
AUTH_TRUSTED_ORIGINS=
# HMAC key for per-screen stream tickets; placeholder only, must match computerd.
SCREEN_TICKET_SECRET=replace-with-a-long-random-secret
# Published HTML pages are served on the API port under their own host (Host header routing): https://ARTIFACT_HOST/a/<signed token>,
# sandboxed by CSP. Dev: usercontent.localhost:8787. Behind a tunnel use another registrable domain than the API's, e.g. API
# https://api.example.com -> ARTIFACT_HOST=usercontent.example.net (production: a dedicated usercontent domain).
ARTIFACT_HOST=usercontent.localhost:8787
# Scheme clients use for ARTIFACT_HOST and Spaces when an edge proxy terminates TLS in front of a plain-http API (default: BETTER_AUTH_URL's).
# EDGE_SCHEME=https
# HMAC key for those URLs; placeholder only, the public API refuses to start without it.
ARTIFACT_URL_SECRET=replace-with-a-long-random-secret
# Spaces (agent-built apps) open on <spaceId>.SPACE_DOMAIN, served by the API port itself (Host header routing). Dev: *.localhost resolves to this machine.
# Behind a tunnel use a different registrable domain than the API host (the API refuses to start over https otherwise): SPACE_DOMAIN=spaces.example.net
SPACE_DOMAIN=spaces.localhost:8787
# HMAC key for the open links and session cookies of Spaces; placeholder only, the public API refuses to start without it.
SPACE_URL_SECRET=replace-with-a-long-random-secret
# Hosted Spaces (BACKEND 5.12 option B, services/spaces-host/README.md): off until these are set; publish-hosted answers 503 and names what is missing.
# Dev: publish to a local `wrangler dev` of the Worker (its .dev.vars must hold the same admin token and signing key).
# SPACES_HOST_LOCAL_URL=http://127.0.0.1:8799
# SPACES_HOST_LOCAL_ADMIN_TOKEN=local-admin-token-change-me
# SPACES_HOST_SIGNING_KEY=local-signing-key-change-me
# SPACES_CONTENT_DOMAIN=spaces-content.localhost:8799
# SPACES_CONTENT_SCHEME=http
#
# Private agent control/execution (packages/agentd). Loopback only; never expose publicly.
AGENTD_PORT=8788
AGENTD_URL=http://127.0.0.1:8788
# Service bearer the public API uses for internal agentd calls; placeholder only.
INTERNAL_AGENTD_TOKEN=replace-with-a-long-random-token
# Bearer of the operator's app catalog path on the public API (/admin/v1/apps: add, edit, hide, retire an
# app without a deploy). A secret of its own, not the service bearer. Empty keeps the path off (404).
ADMIN_TOKEN=
# AES-256-GCM key for secrets stored at rest (MCP server env values). api and agentd refuse to
# start without it. 32 random bytes, base64: openssl rand -base64 32. Losing or changing it makes
# stored encrypted values unreadable (no rotation); placeholder only, never a real key.
SECRETS_KEY=

# MCP connect (remote OAuth servers). The redirect URI is BETTER_AUTH_URL + /oauth/mcp/callback and is
# fixed server-side; register exactly that with any provider that needs a pre-registered client.
# Where the browser lands after a connect attempt (?connection=<id>&status=connected|error).
MCP_OAUTH_RETURN_URL=http://localhost:5199/connectors
# Return URLs a connect request may ask for instead (comma-separated, exact match): the iPhone app's scheme, which
# its sign-in sheet (ASWebAuthenticationSession) catches. Unset = juno://connectors.
MCP_OAUTH_APP_RETURN_URLS=juno://connectors
# Providers without dynamic client registration (Gmail/Calendar via Google). Placeholders only;
# leave empty and Google connections report that no client is configured until these are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft 365 connectors (Outlook mail/calendar, To Do, OneDrive, Contacts, Teams; hosted here on Microsoft Graph).
# An Azure app registration (multi-tenant + personal accounts, Web redirect URI <BETTER_AUTH_URL>/oauth/mcp/callback);
# unset = those catalog entries are unavailable (available: false).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Strava connector (Strava's own MCP). Strava's dynamic registration refuses our redirect URI, so register a client
# with Strava for <BETTER_AUTH_URL>/oauth/mcp/callback and put it here; unset = Connect is disabled (available: false).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Dropbox connector (Dropbox's remote MCP). Its dynamic registration accepts only a trusted list of clients, so create a Dropbox app
# (https://www.dropbox.com/developers/apps) with <BETTER_AUTH_URL>/oauth/mcp/callback as a redirect URI and the scopes account_info.read,
# files.metadata.read/write, files.content.read/write; unset = Connect is disabled (available: false).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Google Maps connector (Maps Grounding Lite) runs on this deployment key; unset = Maps is not offered.
GOOGLE_MAPS_API_KEY=
# Public YouTube connector (search, charts, details; YouTube Data API v3) runs on this deployment key; unset = it is not offered.
YOUTUBE_API_KEY=
# Singapore transport connector (LTA DataMall: bus arrivals, MRT alerts, car parks) account key; unset = it is not offered.
LTA_ACCOUNT_KEY=
# Other public origins the API is reached on (comma-separated, e.g. the phone's Tailscale serve URL). A connector
# sign-in started from one of them returns there; each needs its /oauth/mcp/callback registered with the provider.
PUBLIC_ORIGINS=
# Dev/tests only, default off. 1 lets the MCP connect flow and MCP transport reach loopback and private
# addresses (the e2e fixture needs it). Never set on a deployed API: it turns the SSRF guard off for MCP URLs.
# MCP_ALLOW_PRIVATE_HOSTS=1
#
# Computer (packages/computerd).
COMPUTERD_PORT=8791
COMPUTERD_URL=http://127.0.0.1:8791
# Loopback bind for the private computer service (default 127.0.0.1).
COMPUTERD_HOST=127.0.0.1
# The computer link (BACKEND 7.11): every computer's juno-link dials this endpoint (path /v1/computer-link), so it listens on its own
# port and faces the computers' network. Default 127.0.0.1: Docker Desktop (Mac/Windows) computers reach it at host.docker.internal
# and that works on loopback. A server whose computers are on another network (E2B, Docker on Linux, where the container reaches the
# host through the docker0 bridge) must set it explicitly: 0.0.0.0, or the private-network IP the computers can reach.
# COMPUTERD_LINK_PORT=8795
# COMPUTERD_LINK_HOST=127.0.0.1
# What a new computer dials. Empty: ws://host.docker.internal:<COMPUTERD_LINK_PORT>/v1/computer-link (local Docker only).
# E2B and every other platform must set it to an address the computer can reach (wss://... in production).
# COMPUTERD_LINK_URL=
# Bearer computerd requires; placeholder only, shared by agentd.
COMPUTERD_TOKEN=replace-with-a-long-random-token
# memoryd (BACKEND §2.4): the memory service. The dev launcher starts it on MEMORYD_PORT and points agentd at MEMORYD_URL; set
# MEMORYD_URL yourself only to point agentd at a memoryd running elsewhere. Empty MEMORYD_URL in agentd keeps memory in-process.
# MEMORYD_PORT=8796
# MEMORYD_URL=http://127.0.0.1:8796
# Bearer memoryd and agentd share. Unset, the dev launcher makes a random one per launch; pin it here to keep it across launches.
# MEMORYD_TOKEN=replace-with-a-long-random-token
COMPUTER_RESOLUTION=1440x900
# Timezone of the agent screens (IANA name); no per-user setting yet.
COMPUTER_TIMEZONE=UTC
#
# Push notifications (APNs, token-based auth; paid Apple developer team only). Leave empty to run with push off.
# APNS_KEY_PATH points at the downloaded .p8 file; APNS_KEY may hold the PEM inline with \n escapes.
# Sandbox vs production is chosen per device by the app at registration, not by an env var.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_KEY=
APNS_TOPIC=
#
# Push notifications for Android (FCM HTTP v1). FCM_SERVICE_ACCOUNT is the Firebase service account key JSON
# (Firebase console > Project settings > Service accounts > Generate new private key) pasted on ONE line;
# the project id comes from the JSON. Leave empty to run with Android push off (iOS push is independent).
FCM_SERVICE_ACCOUNT=
#
# Channels (Telegram): public base URL Telegram can reach for webhooks, e.g. https://api.example.com. Leave unset to receive by long polling (no public URL needed).
# CHANNELS_PUBLIC_URL=
#
# Shared Juno Slack app (one app for every workspace; each agent gets a user group). Needs CHANNELS_PUBLIC_URL.
# Create the app once from the manifest in packages/agentd/src/channels/slack-shared.ts (slackSharedManifest).
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
#
# Shared Juno Discord bot (one bot for every server; each agent gets a mentionable role). Needs CHANNELS_PUBLIC_URL, the redirect
# <CHANNELS_PUBLIC_URL>/v1/channels/discord/oauth/callback registered in the Developer Portal, and the MESSAGE_CONTENT intent switched on.
# DISCORD_APP_ID=
# DISCORD_BOT_TOKEN=
#
# Optional: base URL of the agent avatar images (<base>/<character>.png) used as icon_url / avatar_url on the shared Slack app / Discord bot.
# CHANNELS_AVATAR_BASE_URL=   (e.g. <CHANNELS_PUBLIC_URL>/v1/agent-avatars, served by the api)
#
# Model (OpenAI-compatible). Provider selection is fail-fast: set BOTH values or
# the service refuses to start. An empty MODEL_BASE_URL does NOT fall back to scripted.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# Reasoning tier of user-facing chat runs: quick (default) | standard | deep. Child tasks, routines and background jobs have
# fixed tiers (execution/brain/reasoning-tier.ts); an owner's own reasoning-effort setting wins over the tier. For measuring.
# CHAT_EFFORT_TIER=quick
# Scripted test double is explicit opt-in only (tests): MODEL_PROVIDER=scripted plus
# the script file. Never set this for live dev.
# MODEL_PROVIDER=
# SCRIPTED_MODEL_FILE=
#
# Sandbox provider. Live default is e2b, never fake; the fake display provider is
# explicit opt-in for tests (COMPUTER_PROVIDER=fake). Local Docker sandbox is
# explicit opt-in (COMPUTER_PROVIDER=local). Live E2B runs need E2B settings.
# COMPUTER_PROVIDER=
E2B_API_KEY=
E2B_API_URL=
E2B_SANDBOX_URL=
E2B_TEMPLATE=desktop-debian
LOCAL_SANDBOX_IMAGE=juno-desktop:local
#
# Optional settings, all commented with their code defaults. Server deployment: deploy/README.md.
# Public web: absolute path of the built frontend web app (built in the frontend repository: pnpm --filter @agent-desktop/web build -> packages/web/dist).
# When set, the api serves the web app same-origin at / (index.html fallback; /v1, /auth, /healthz are never
# intercepted). Unset serves no web files (dev uses the vite server on 5199).
# WEB_DIST=
# Log level for every service (pino): trace|debug|info|warn|error.
# LOG_LEVEL=info
# Model extras. MODEL_SUPPORTS_IMAGES is "true" or "false".
# MODEL_PRICING_JSON is a JSON array of {baseUrl, modelId, input, output, cacheRead, cacheWrite} (USD per
# million tokens); empty keeps cost unknown.
# Platform-paid fast model for background one-shots (run titles, role suggestions, memory jobs, goal briefing,
# ideas). Applies only when FAST_MODEL_ID is set; a blank base URL / key reuses MODEL_BASE_URL / MODEL_API_KEY. An
# owner's own "fast model" setting wins; without either, the owner's provider's cheap model, then their agent model.
# FAST_MODEL_ID=
# FAST_MODEL_BASE_URL=
# FAST_MODEL_API_KEY=
# Platform System One (typed-decision) model, used for judgments such as the purchase and dialog reviewers: a Jev /
# TypeSafe-compatible `POST {base}/v1/systemone` (TypeSafe, a gateway, or a self-hosted open model). Applies only when the base
# URL and key are both set; the model id defaults to jev-latest. An owner's own System One provider wins; without either,
# the fast model answers the same typed questions (emulation), and with no model at all the judgments fail closed.
# SYSTEM_ONE_BASE_URL=https://api.typesafe.ai
# SYSTEM_ONE_API_KEY=
# SYSTEM_ONE_MODEL_ID=jev-latest

# Original Jev MCP browser integration: off by default, even when System One is configured.
# Requires a real native Jev/System One model and the packaged Chromium MCP runtime; fast-model emulation does not enable it.
JEV_BROWSER_MCP_ENABLED=0
# Optional fallback for a turn whose primary model keeps failing transiently after its retries. Same endpoint
# as MODEL_BASE_URL; it inherits MODEL_SUPPORTS_IMAGES and uses its own MODEL_PRICING_JSON entry. Blank disables it.
# MODEL_FALLBACK_ID=
# MODEL_SUPPORTS_IMAGES=false
# MODEL_PRICING_JSON=
# Smallest allowed routine interval in ms (default 5 minutes = 300000). Tests lower it.
# ROUTINE_MIN_INTERVAL_MS=300000
# Stream ticket lifetime in ms (default 5 minutes).
# SCREEN_TICKET_TTL_MS=300000
# File bytes (uploads, sent files, artifact files, transcript images; never in Postgres). local = a directory,
# s3 = the STORAGE_S3_* bucket below under the blobs/ prefix. api and agentd must use the same store.
# BLOB_STORE=local
# BLOB_DIR=.data/blobs   (relative to the backend root)
# BLOB_S3_REGION=us-east-1
# Computer sizing and lifetime (computerd).
# COMPUTER_TIMEOUT_MS=3600000
# COMPUTER_IDLE_PAUSE_MINUTES=30
# COMPUTER_RAM_GB=2
# COMPUTER_VCPU=2
# Durable files (BACKEND 7.10). Unset: local-volume with COMPUTER_PROVIDER=local, none (the computer's own disk) otherwise.
# Local Docker defaults to 2 vCPU / 4 GB here; E2B stays 2 vCPU / 2 GB. Set COMPUTER_RAM_GB / COMPUTER_VCPU to override either.
# COMPUTER_STORAGE=local-volume
# JuiceFS for E2B / any FUSE-capable Linux: file data in an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO), metadata in Postgres.
# STORAGE_META_URL must be its own database (computerd creates one schema per user in it), not the app's.
# COMPUTER_STORAGE=juicefs
# STORAGE_META_URL=postgres://juicefs:CHANGE_ME@127.0.0.1:5432/juicefs_meta
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=juno-files
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# Web search tool (web_search). Empty SEARCH_PROVIDER = no web_search tool; web_fetch needs no key.
# SEARCH_PROVIDER is exa (recommended: results carry images for feed posts), brave or tavily; a set provider with an empty SEARCH_API_KEY refuses to start.
# SEARCH_PROVIDER=
# SEARCH_API_KEY=

# Transcription service (Discord voice notes; later the Slack huddle skill): an OpenAI-compatible /audio/transcriptions endpoint.
# Without TRANSCRIPTION_BASE_URL and TRANSCRIPTION_API_KEY the discord_voice_join tool says transcription is not configured.
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# Spoken replies (Apple Watch): the Kokoro-82M sidecar in services/tts, started by `pnpm dev:backend` when TTS_ENABLED=1.
# TTS_PYTHON is a python with services/tts/requirements.txt installed. Without TTS_ENABLED, POST /v1/speech answers 503
# SPEECH_UNAVAILABLE and the client speaks on the device. TTS_ESPEAK_* point at a system espeak-ng (needed on macOS, where
# the pip wheel's compiled data path is broken; Homebrew paths shown).
# TTS_ENABLED=1
# TTS_PYTHON=/path/to/venv/bin/python
# TTS_PORT=8792
# TTS_ESPEAK_LIBRARY=/opt/homebrew/lib/libespeak-ng.dylib
# TTS_ESPEAK_DATA=/opt/homebrew/share/espeak-ng-data

# Memory search vectors: a hosted OpenAI-compatible /embeddings endpoint. Without all three values (or while the API fails)
# memory is searched by keywords only. Switching provider is config only: changed vectors are re-embedded in the background.
# Jina's free tier is non-commercial: a commercial deployment needs a paid Jina key or another provider (Cloudflare Workers AI,
# SiliconFlow, OpenAI ...).
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=jina-embeddings-v5-text-small
# Optional: sent as `dimensions` only when set (Matryoshka models). Leave empty for the model's own size.
# EMBEDDING_DIMENSIONS=
