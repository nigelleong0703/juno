{
  "name": "@agent-desktop/spaces-host",
  "version": "0.0.0",
  "description": "Hosted Spaces (BACKEND 5.12, option B): a Cloudflare Worker that serves published Spaces from R2 and D1, and the publisher the API uses to write them.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev --config wrangler.dev.toml --port 8799",
    "deploy": "wrangler deploy --config wrangler.toml"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "4.151.3"
  }
}
