# Juno server deploy template. Copy is NEVER needed: run
#   node deploy/setup.mjs
# which creates deploy/.env from this file and fills generated secrets
# idempotently (existing values are never overwritten). deploy/.env is
# gitignored (root .gitignore + deploy/.gitignore) and written mode 600.
#
# Quickstart (from the repo root):
#   node deploy/setup.mjs
#   docker compose --env-file deploy/.env -f deploy/compose.yml up -d --build
# One-command install (generates secrets, validates, builds, starts, verifies):
#   node deploy/setup.mjs --up
# Self-check creates deploy/.env if missing and validates secrets + Compose:
#   node deploy/setup.mjs --check

COMPOSE_PROJECT_NAME=juno
JUNO_IMAGE_TAG=local

# ---------------------------------------------------------------- Postgres
# The database lives in the compose network (never published). Credentials are
# generated by setup; DATABASE_URL must match POSTGRES_* below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=agents
DATABASE_URL=

# --------------------------------------------------------------- Public edge
# The only published ports. QA defaults avoid every live dev port
# (8787/8788/8791/5199/54330). On a real server set 80/443.
EDGE_HTTP_PORT=18487
EDGE_HTTPS_PORT=18488
EDGE_HTTP_BIND=127.0.0.1
EDGE_HTTPS_BIND=127.0.0.1

# Public base URL of this deployment (Better Auth origin, webhooks, OAuth
# callbacks). QA default below; a server uses https://<its domain>.
BETTER_AUTH_URL=http://127.0.0.1:18487
# Caddy site addresses. Keep http:// for loopback QA; use bare DNS names on a
# public server so Caddy provisions TLS certificates.
API_SITE=http://127.0.0.1
ARTIFACT_SITE=http://usercontent.localhost
SPACE_WILDCARD=http://*.spaces.localhost
# Selects a configuration already bundled in juno-edge; edit deploy/Caddyfile*
# and rebuild the edge image to change its contents.
CADDYFILE_PATH=./Caddyfile.qa
AUTH_MODE=account
# Extra browser origins allowed to sign in, comma-separated. The
# BETTER_AUTH_URL origin needs no entry.
AUTH_TRUSTED_ORIGINS=

# ------------------------------------------- Untrusted-content hosts (edge)
# Served by the SAME edge ports, routed by Host header to the internal api.
# They must be different hostnames from the API host: the api refuses to boot
# when ARTIFACT_HOST/SPACE_DOMAIN equals or contains the API host, and throws
# on https when they share the API's registrable domain (backend
# packages/api/src/edge-hosts.ts). QA uses *.localhost (resolves to 127.0.0.1).
ARTIFACT_HOST=usercontent.localhost:18487
SPACE_DOMAIN=spaces.localhost:18487

# ------------------------------------------------------------------ Secrets
# All generated by setup (crypto random). Placeholders start with
# "replace-with-" and are rejected by --check. SECRETS_KEY encrypts stored MCP
# credentials at rest: it cannot be rotated; losing it makes stored encrypted
# values unreadable. Back up deploy/.env.
BETTER_AUTH_SECRET=
INTERNAL_AGENTD_TOKEN=
ADMIN_TOKEN=
# AES-256-GCM key for secrets at rest: 32 random bytes, base64
# (openssl rand -base64 32). api and agentd refuse to start without it.
SECRETS_KEY=
# HMAC key for per-screen stream tickets; must match between api/agentd/computerd.
SCREEN_TICKET_SECRET=
# HMAC keys for artifact render URLs and Space open links/session cookies.
# The public api refuses to start without them.
ARTIFACT_URL_SECRET=
SPACE_URL_SECRET=
# Bearer computerd requires; shared by agentd. Spaces cannot reach computers
# without it (status unknown, previews fail).
COMPUTERD_TOKEN=

# ------------------------------------------------------- Internal services
# The supervisor co-locates these processes; keep their API URLs on loopback.
AGENTD_URL=http://127.0.0.1:8788
COMPUTERD_URL=http://127.0.0.1:8791
API_HOST=0.0.0.0
API_PORT=8787
AGENTD_PORT=8788
COMPUTERD_PORT=8791
COMPUTERD_HOST=127.0.0.1
# Local Docker computers dial host.docker.internal. On Linux, the optional
# overlay binds this port only to DOCKER_BRIDGE_HOST, the actual Docker bridge
# gateway. A sandbox cannot reach a host port bound to 127.0.0.1.
COMPUTERD_LINK_PORT=8795
COMPUTERD_LINK_HOST=0.0.0.0
COMPUTERD_LINK_URL=
COMPUTERD_MAC_LINK_URL=
DOCKER_BRIDGE_HOST=

# ---------------------------------------------------------------- Sandbox
# Sandbox provider. "local" is lazy and needs the optional Docker socket
# overlay before an owner requests a computer. "e2b" needs its endpoint/key
# plus a reachable COMPUTERD_LINK_URL. There is no fake provider here.
COMPUTER_PROVIDER=local
# Local Docker image for COMPUTER_PROVIDER=local (backend
# packages/sandbox-image/local, DEFAULT_LOCAL_IMAGE). Sandboxes are created
# lazily on first use; the image must exist on the host by then
# (see deploy/README.md). Health checks do not need it.
LOCAL_SANDBOX_IMAGE=juno-desktop:local
# E2B (only for COMPUTER_PROVIDER=e2b). Self-hosted needs BOTH URLs or the SDK
# falls back to E2B cloud.
E2B_API_KEY=
E2B_API_URL=
E2B_SANDBOX_URL=
E2B_TEMPLATE=desktop-debian
# Self-hosted E2B caps sandbox TTL at 1h; refreshed on every attach.
COMPUTER_TIMEOUT_MS=3600000
COMPUTER_IDLE_PAUSE_MINUTES=30
COMPUTER_RESOLUTION=1440x900
COMPUTER_TIMEZONE=UTC
# COMPUTER_RAM_GB=4
# COMPUTER_VCPU=2

# ------------------------------------------------------------------- Model
# Platform default model (OpenAI-compatible). Provide BOTH base URL and model
# id, or neither: without a platform default, `--check` still passes, while
# `--up` requires an explicit --allow-unconfigured-model flag for a web/API-only
# launch where an owner will configure a provider in Settings > Model providers.
# No model is fabricated or substituted.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_ID=
# MODEL_WIRE_API=responses
# Optional fallback turn model (same endpoint). Blank disables it.
# MODEL_FALLBACK_ID=
# MODEL_SUPPORTS_IMAGES=false
# MODEL_PRICING_JSON=

# ------------------------------------------------------------------ Storage
# File bytes live in /data (persistent named volume). Postgres keeps metadata.
BLOB_DIR=/data/blobs
MEDIA_CACHE_DIR=/data/media
SITE_ICON_CACHE_DIR=/data/site-icons
COMPUTER_BINDING_FILE=/data/computerd/binding.json
SCREEN_REGISTRY_FILE=/data/computerd/screen-pool.json
MAC_REGISTRY_FILE=/data/computerd/mac-links.json

# --------------------------------------------------------------------- Misc
# LOG_LEVEL=info
# Web search tool: empty = no web_search tool (web_fetch needs no key).
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
# Push notifications (APNs, paid Apple developer team). Empty = push off.
# APNS_KEY holds the .p8 PEM inline with \n escapes (no key file is mounted in the container).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY=
# APNS_TOPIC=

# ------------------------------------------------------------- Integrations
# Everything below is optional. Blank = that integration is not offered; nothing
# is faked. deploy/README.md says how to register each one and which redirect
# URL to enter. All callbacks are built from BETTER_AUTH_URL.
# Public base URL the chat platforms reach (webhooks, install redirects). Needed
# for Slack, Discord and Telegram webhooks; without it Telegram polls.
# CHANNELS_PUBLIC_URL=
# Where the browser lands after a connector sign-in (default: BETTER_AUTH_URL + /connectors).
# MCP_OAUTH_RETURN_URL=
# Extra public origins the API is reached on (comma-separated).
# PUBLIC_ORIGINS=
# Chat platforms: one Slack app, one Discord bot and one Telegram manager bot for the whole server.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# DISCORD_APP_ID=
# DISCORD_BOT_TOKEN=
# TELEGRAM_MANAGER_BOT_TOKEN=
# Connectors that need a client registered by the operator.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# Connectors that run on a deployment API key.
# GOOGLE_MAPS_API_KEY=
# YOUTUBE_API_KEY=
# LTA_ACCOUNT_KEY=
# Composio (long-tail apps whose login Composio holds) and the auth configs of the two toolkits without a managed OAuth app.
# COMPOSIO_API_KEY=
# COMPOSIO_AUTH_CONFIG_SPOTIFY=
# COMPOSIO_AUTH_CONFIG_SHOPIFY=
